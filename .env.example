# Copie para .env (local) ou cadastre na Vercel em Settings > Environment Variables.
# Use somente a URL e a chave PUBLICÁVEL (anon/publishable) do projeto Supabase.
# NUNCA coloque a service role key nem a ANTHROPIC_API_KEY aqui: elas ficam como segredos das Edge Functions.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable
VITE_SUPABASE_PROJECT_ID=SEU-PROJETO
